# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# R2 Storage Configuration
VITE_R2_WORKER_URL=
VITE_R2_PUBLIC_DOMAIN=

# Development
VITE_USE_EMULATORS=false

# Razorpay (use LIVE key for production; test key for development)
# Get from: Dashboard → Settings → API Keys (switch to Live mode)
VITE_RAZORPAY_KEY_ID=

# Subscription: set to "true" to enable upgrade/downgrade/cancel buttons. When false, users can only view plans (trial mode).
VITE_SUBSCRIPTION_BUTTONS_ENABLED=false

# E2E: Set to a shop's public slug to run full public-order flow tests (npm run test:e2e)
# E2E_PUBLIC_SHOP_SLUG=
