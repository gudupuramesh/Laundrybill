{
  "expo": {
    "name": "Laundrybill",
    "slug": "laundrybill",
    "scheme": "laundrybill",
    "version": "1.5.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#13253d"
    },
    "ios": {
      "appleTeamId": "QWW8YD6KZV",
      "supportsTablet": true,
      "bundleIdentifier": "in.laundrybill",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "6",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.laundrybill",
      "googleServicesFile": "./google-services.json",
      "versionCode": 27,
      "adaptiveIcon": {
        "backgroundColor": "#13253d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-dev-client",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-contacts",
        {
          "contactsPermission": "Laundrybill uses your contacts to quickly add customers. Your contact data stays on your device and is never shared."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Laundrybill needs camera access to scan QR codes printed on order bags and item tags for quick order tracking and pickup verification."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Laundrybill uses your location to auto-fill your shop address during registration and to show your shop on the map for customers.",
          "locationAlwaysPermission": "Laundrybill uses your location to auto-fill your shop address during registration and to show your shop on the map for customers.",
          "locationWhenInUsePermission": "Laundrybill uses your location to auto-fill your shop address during registration and to show your shop on the map for customers."
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      "./plugins/withApsEnvironmentProduction"
    ],
    "extra": {
      "eas": {
        "projectId": "24fa0331-56d3-4b39-9cd3-6bb04a0a108a"
      }
    },
    "owner": "gudupuramesh"
  }
}
