{
  "expo": {
    "name": "Laundrybill",
    "slug": "laundrybill",
    "scheme": "laundrybill",
    "version": "1.5.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#13253d"
    },
    "ios": {
      "appleTeamId": "QWW8YD6KZV",
      "supportsTablet": true,
      "bundleIdentifier": "in.laundrybill",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "11",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Laundrybill uses your photos to add pictures to orders, service items, and your shop profile."
      },
      "splash": {
        "image": "./assets/splash-ios.png",
        "resizeMode": "cover",
        "backgroundColor": "#02326A"
      }
    },
    "android": {
      "package": "in.laundrybill",
      "googleServicesFile": "./google-services.json",
      "versionCode": 30,
      "adaptiveIcon": {
        "backgroundColor": "#13253d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0148A2"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-dev-client",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-contacts",
        {
          "contactsPermission": "Laundrybill uses your contacts to quickly add customers. Your contact data stays on your device and is never shared."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Laundrybill uses the camera only to scan the QR codes and barcodes on order tags and bags. Nothing is photographed, recorded, or saved \u2014 the camera is used live just to read the code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Laundrybill uses your location to auto-fill your shop address during registration and to show your shop on the map for customers.",
          "locationAlwaysPermission": "Laundrybill uses your location to auto-fill your shop address during registration and to show your shop on the map for customers.",
          "locationWhenInUsePermission": "Laundrybill uses your location to auto-fill your shop address during registration and to show your shop on the map for customers."
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      "./plugins/withApsEnvironmentProduction"
    ],
    "extra": {
      "eas": {
        "projectId": "24fa0331-56d3-4b39-9cd3-6bb04a0a108a"
      }
    },
    "owner": "gudupuramesh"
  }
}