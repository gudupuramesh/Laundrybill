{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "sync-locales": "cp ../src/locales/*.json ./src/locales/",
    "postinstall": "patch-package",
    "start": "env -u CI expo start",
    "start:dev": "env -u CI expo start --dev-client",
    "start:dev:clear": "env -u CI expo start --dev-client -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/auth": "^23.8.8",
    "@react-native-firebase/firestore": "^23.8.8",
    "@react-native-firebase/functions": "^23.8.8",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "country-telephone-data": "^0.6.3",
    "country-to-currency": "^2.0.3",
    "currency-symbol-map": "^5.1.0",
    "expo": "^54.0.33",
    "expo-auth-session": "~7.0.10",
    "expo-camera": "~17.0.10",
    "expo-contacts": "~15.0.11",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.11.0",
    "i18next": "^23.16.8",
    "react": "19.1.0",
    "react-i18next": "^15.1.2",
    "react-native": "0.81.5",
    "react-native-purchases": "^9.15.0",
    "react-native-purchases-ui": "^9.15.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
