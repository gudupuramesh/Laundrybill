# Razorpay (LIVE credentials for real payments)
# Get from: Dashboard → Settings → API Keys (Live mode). Webhook secret from Settings → Webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Play subscription verification (verifyGooglePurchase)
# Paste the entire JSON from Google Cloud → Service account → Keys → Create JSON (one line in .env is OK).
# Do NOT commit real keys; keep only in functions/.env locally or in Firebase/Cloud secrets.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Must match applicationId in the Android app (e.g. in.laundrybill).
GOOGLE_PLAY_PACKAGE_NAME=in.laundrybill
# Firestore plan document id that mobile IAP is allowed to activate (usually pro).
PRIMARY_PAID_PLAN_ID=pro

# Apple IAP verification (verifyApplePurchase)
# App Store Connect → App → Subscriptions → App-Specific Shared Secret
APPLE_SHARED_SECRET=

# ZeptoMail Configuration
ZEPTOMAIL_API_KEY="Zoho-enczapikey xxxxxxxxxxxxxxxxxxxxxxxx"
ZEPTOMAIL_SENDER_EMAIL="noreply@laundrybill.com"
ZEPTOMAIL_SENDER_NAME="LaundryBoss"

# R2 Worker (for scheduled cleanup of order images)
R2_WORKER_URL="https://your-r2-worker.example.com"

# PhonePe Configuration (Future Use)
PHONEPE_MERCHANT_ID="MERCHANTID"
PHONEPE_SALT_KEY="salt-key-xxxxxxxx"
PHONEPE_SALT_INDEX="1"
